# ---------------------------------------------------------------------------
# Vraj Chem Impex LLP — environment
# Copy to .env.local for development, and set the same keys in Vercel for production.
# ---------------------------------------------------------------------------

# Canonical site URL. Used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://vrajchem.com

# ---------------------------------------------------------------------------
# Contact identity
# Replacing these switches the footer, contact page, action bar and both
# schema.org blocks to the domain mailbox. Do this before launch — a personal
# Gmail as the published business contact costs credibility with overseas buyers.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SALES_EMAIL=sales@vrajchem.com
NEXT_PUBLIC_EXPORT_EMAIL=export@vrajchem.com

# ---------------------------------------------------------------------------
# Lead delivery — CONFIGURE AT LEAST ONE.
#
# With none of these set, the API refuses the submission with a 502 and tells the
# buyer to phone instead. That is deliberate: the site must never tell someone
# "we will contact you within 24 hours" for a lead that reached nobody.
# ---------------------------------------------------------------------------

# 1. Transactional email (https://resend.com). LEAD_FROM_EMAIL must be on a
#    domain verified with the provider, or mail lands in spam.
RESEND_API_KEY=
LEAD_FROM_EMAIL=Vraj Chem <enquiries@vrajchem.com>

# 2. Webhook intake — Zapier, Make, Slack, Google Sheets or a CRM endpoint.
LEAD_WEBHOOK_URL=

# 3. Append-only JSONL on a persistent disk. On Vercel this must point at a
#    mounted volume; the default /tmp does not survive a cold start and is
#    therefore not treated as durable.
LEAD_STORE_DIR=

# Optional. Overrides who receives the internal lead notification. Comma-separated.
# Unset, an RFQ goes to the export desk and a contact enquiry to sales, with the
# sales inbox copied on both so no lead depends on one mailbox being watched.
LEAD_NOTIFY_EMAIL=

# Optional. Points the mail client at a stub instead of Resend, for testing the
# delivery path end to end without sending real mail.
RESEND_BASE_URL=

# 4. No-credential email relay (FormSubmit or equivalent). Posts a flat JSON body that
#    the service forwards to one fixed mailbox. Lets a demo deployment deliver leads to
#    a real inbox without a transactional-email account. Note the first submission
#    triggers a one-time activation email that must be confirmed, and a third party sits
#    in the delivery path — move to RESEND_API_KEY before a real launch.
LEAD_RELAY_URL=

# ---------------------------------------------------------------------------
# Demo / staging overrides
# ---------------------------------------------------------------------------

# Link target for every WhatsApp button. No control renders the number — only an icon or
# the label "WhatsApp enquiry" — so changing this reroutes conversations without altering
# the published contact block. Country code, no plus, no spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=
